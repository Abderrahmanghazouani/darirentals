<!DOCTYPE html>
<html>
<head>
    <title>Invoice</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 18px;
            line-height: 1.5;
            margin: 0;
            padding: 0;

        }

        .container {
            max-width: 600px;
            margin: 0 auto;
            border: 1px solid #ccc;
            background-color: #fff;
            box-shadow: 0 0 10px #ddd;
        }

        .header {
            text-align: left;
            margin-bottom: 20px;
        }

        .header h1 {
            font-size: 35px;
            font-weight: bold;
            margin: 0;
            color: #c9302c;
        }

        .company-info {
            margin-bottom: 20px;
        }

        .company-info p {
            margin: 0;
            line-height: 1.5;
        }

        .invoice-details {
            margin-bottom: 20px;
        }

        .invoice-details p {
            margin: 0;
            line-height: 1.5;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            height: 40px;
            text-align: left;
            font-size: 17px;
            padding: 8px;
            border-bottom: 1px solid #ddd;
        }

        th {
            font-weight: bold;
        }

        .totals {
            margin-top: 20px;
            text-align: left;
        }

        .totals p {
            margin: 0;
            line-height: 1.5;
        }

        .footer {
            text-align: center;
        }

        .footer p {
            margin: 0;
            line-height: 1.5;
        }

    </style>
</head>
<body>
<div class="container">
    <div class="header" style="font-family: Noto Sans JP, sans-serif;">
        <h1>REÇU</h1>
    </div>
    <br/>
    <hr style="color:#c9302c ;height: 3px"></hr>
    <br/>

    #macro(displayComposedDataIfNotNull $object $dataToDisplay)
    #if($object)$dataToDisplay#else---#end
    #end
    #macro(displayDataIfNotNull $object)
    #if($object)$object#else---#end
    #end
    <table style="width: 100%">

                        <tr>
                    <td style="text-align: left;border-bottom: 0"><span style="font-weight: bold;">Code:</span> #displayDataIfNotNull($code)</td>
                </tr>
                <tr>
                    <td style="text-align: left;border-bottom: 0"><span style="font-weight: bold;">Label:</span> #displayDataIfNotNull($label)</td>
                </tr>
                <tr>
                    <td style="text-align: left;border-bottom: 0"><span style="font-weight: bold;">Style:</span> #displayDataIfNotNull($style)</td>
                </tr>
                <tr>
                    <td style="text-align: left;border-bottom: 0"><span style="font-weight: bold;">Is default:</span> #displayDataIfNotNull($isDefault)</td>
                </tr>
                <tr>
                    <td style="text-align: left;border-bottom: 0"><span style="font-weight: bold;">Sort order:</span> #displayDataIfNotNull($sortOrder)</td>
                </tr>
                <tr>
                    <td style="text-align: left;border-bottom: 0"><span style="font-weight: bold;">Symbol:</span> #displayDataIfNotNull($symbol)</td>
                </tr>

    </table>
    <br/><br/><br/><br/><br/>
    <h1>Exchange rates as base</h1>
    <table>
        <thead>
            <tr>
                <th>Rate</th>
                <th>Source</th>
            </tr>
        </thead>
        <tbody>
                #foreach( $item in $exchangeRatesAsBase )
                #if( ($foreach.index % 2) == 0 )
                <tr style="background-color: #f4f5f6">
                    #else
                <tr style="background-color: #e9ebec">
                    #end
                    <td>#displayDataIfNotNull($item.rate)</td>
                    <td>#displayDataIfNotNull($item.source)</td>
                </tr>
                #end
        </tbody>
    </table>
    <h1>Exchange rates as target</h1>
    <table>
        <thead>
            <tr>
                <th>Rate</th>
                <th>Source</th>
            </tr>
        </thead>
        <tbody>
                #foreach( $item in $exchangeRatesAsTarget )
                #if( ($foreach.index % 2) == 0 )
                <tr style="background-color: #f4f5f6">
                    #else
                <tr style="background-color: #e9ebec">
                    #end
                    <td>#displayDataIfNotNull($item.rate)</td>
                    <td>#displayDataIfNotNull($item.source)</td>
                </tr>
                #end
        </tbody>
    </table>
    <h1>Enterprises</h1>
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Phone</th>
                <th>Address</th>
            </tr>
        </thead>
        <tbody>
                #foreach( $item in $enterprises )
                #if( ($foreach.index % 2) == 0 )
                <tr style="background-color: #f4f5f6">
                    #else
                <tr style="background-color: #e9ebec">
                    #end
                    <td>#displayDataIfNotNull($item.name)</td>
                    <td>#displayDataIfNotNull($item.phone)</td>
                    <td>#displayDataIfNotNull($item.address)</td>
                </tr>
                #end
        </tbody>
    </table>
    <h1>Collaborators</h1>
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Phone</th>
                <th>Is active</th>
                <th>Email</th>
                <th>Enabled</th>
                <th>Credentials non expired</th>
                <th>Account non expired</th>
                <th>Username</th>
                <th>Password changed</th>
                <th>Account non locked</th>
                <th>Password</th>
            </tr>
        </thead>
        <tbody>
                #foreach( $item in $collaborators )
                #if( ($foreach.index % 2) == 0 )
                <tr style="background-color: #f4f5f6">
                    #else
                <tr style="background-color: #e9ebec">
                    #end
                    <td>#displayDataIfNotNull($item.name)</td>
                    <td>#displayDataIfNotNull($item.phone)</td>
                    <td>#displayDataIfNotNull($item.isActive)</td>
                    <td>#displayDataIfNotNull($item.email)</td>
                    <td>#displayDataIfNotNull($item.enabled)</td>
                    <td>#displayDataIfNotNull($item.credentialsNonExpired)</td>
                    <td>#displayDataIfNotNull($item.accountNonExpired)</td>
                    <td>#displayDataIfNotNull($item.username)</td>
                    <td>#displayDataIfNotNull($item.passwordChanged)</td>
                    <td>#displayDataIfNotNull($item.accountNonLocked)</td>
                    <td>#displayDataIfNotNull($item.password)</td>
                </tr>
                #end
        </tbody>
    </table>
    <br/><br/>

    <div class="footer">
        <p style="font-size: 25px">MERCI POUR VOTRE SERVICE!</p>
        <p style="font-size: 18px">Si vous avez des questions, veillez contacter nous.</p>
    </div>
    <br/><br/>
    <hr style="color:#c9302c ;height: 3px"></hr>
</div>
</body>
</html>

