<!DOCTYPE html>
<html>
<head>
    <title>Invoice</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 18px;
            line-height: 1.5;
            margin: 0;
            padding: 0;

        }

        .container {
            max-width: 600px;
            margin: 0 auto;
            border: 1px solid #ccc;
            background-color: #fff;
            box-shadow: 0 0 10px #ddd;
        }

        .header {
            text-align: left;
            margin-bottom: 20px;
        }

        .header h1 {
            font-size: 35px;
            font-weight: bold;
            margin: 0;
            color: #c9302c;
        }

        .company-info {
            margin-bottom: 20px;
        }

        .company-info p {
            margin: 0;
            line-height: 1.5;
        }

        .invoice-details {
            margin-bottom: 20px;
        }

        .invoice-details p {
            margin: 0;
            line-height: 1.5;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            height: 40px;
            text-align: left;
            font-size: 17px;
            padding: 8px;
            border-bottom: 1px solid #ddd;
        }

        th {
            font-weight: bold;
        }

        .totals {
            margin-top: 20px;
            text-align: left;
        }

        .totals p {
            margin: 0;
            line-height: 1.5;
        }

        .footer {
            text-align: center;
        }

        .footer p {
            margin: 0;
            line-height: 1.5;
        }

    </style>
</head>
<body>
<div class="container">
    <div class="header" style="font-family: Noto Sans JP, sans-serif;">
        <h1>REÇU</h1>
    </div>
    <br/>
    <hr style="color:#c9302c ;height: 3px"></hr>
    <br/>

    #macro(displayComposedDataIfNotNull $object $dataToDisplay)
    #if($object)$dataToDisplay#else---#end
    #end
    #macro(displayDataIfNotNull $object)
    #if($object)$object#else---#end
    #end
    <table style="width: 100%">

                        <tr>
                    <td style="text-align: left;border-bottom: 0"><span style="font-weight: bold;">Name:</span> #displayDataIfNotNull($name)</td>
                </tr>
                <tr>
                    <td style="text-align: left;border-bottom: 0"><span style="font-weight: bold;">Phone:</span> #displayDataIfNotNull($phone)</td>
                </tr>
                <tr>
                    <td style="text-align: left;border-bottom: 0"><span style="font-weight: bold;">Address:</span> #displayDataIfNotNull($address)</td>
                </tr>
                <tr>
                    <td style="text-align: left;border-bottom: 0"><span style="font-weight: bold;">Currency:</span> #displayComposedDataIfNotNull($currency,$currency.label)</td>
                </tr>

    </table>
    <br/><br/><br/><br/><br/>
    <h1>Properties</h1>
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Street number</th>
                <th>Street name</th>
                <th>Postal code</th>
                <th>Capacity</th>
                <th>Price per night</th>
                <th>Latitude</th>
                <th>Longitude</th>
                <th>Property type</th>
                <th>Property status</th>
                <th>City</th>
            </tr>
        </thead>
        <tbody>
                #foreach( $item in $properties )
                #if( ($foreach.index % 2) == 0 )
                <tr style="background-color: #f4f5f6">
                    #else
                <tr style="background-color: #e9ebec">
                    #end
                    <td>#displayDataIfNotNull($item.name)</td>
                    <td>#displayDataIfNotNull($item.streetNumber)</td>
                    <td>#displayDataIfNotNull($item.streetName)</td>
                    <td>#displayDataIfNotNull($item.postalCode)</td>
                    <td>#displayDataIfNotNull($item.capacity)</td>
                    <td>#displayDataIfNotNull($item.pricePerNight)</td>
                    <td>#displayDataIfNotNull($item.latitude)</td>
                    <td>#displayDataIfNotNull($item.longitude)</td>
                    <td>#displayDataIfNotNull($item.propertyType,$item.propertyType.label)</td>
                    <td>#displayDataIfNotNull($item.propertyStatus,$item.propertyStatus.label)</td>
                    <td>#displayDataIfNotNull($item.city,$item.city.name)</td>
                </tr>
                #end
        </tbody>
    </table>
    <h1>Clients</h1>
    <table>
        <thead>
            <tr>
                <th>Full name</th>
                <th>Phone</th>
                <th>Nationality</th>
                <th>Email</th>
                <th>Enabled</th>
                <th>Credentials non expired</th>
                <th>Account non expired</th>
                <th>Username</th>
                <th>Password changed</th>
                <th>Account non locked</th>
                <th>Password</th>
            </tr>
        </thead>
        <tbody>
                #foreach( $item in $clients )
                #if( ($foreach.index % 2) == 0 )
                <tr style="background-color: #f4f5f6">
                    #else
                <tr style="background-color: #e9ebec">
                    #end
                    <td>#displayDataIfNotNull($item.fullName)</td>
                    <td>#displayDataIfNotNull($item.phone)</td>
                    <td>#displayDataIfNotNull($item.nationality)</td>
                    <td>#displayDataIfNotNull($item.email)</td>
                    <td>#displayDataIfNotNull($item.enabled)</td>
                    <td>#displayDataIfNotNull($item.credentialsNonExpired)</td>
                    <td>#displayDataIfNotNull($item.accountNonExpired)</td>
                    <td>#displayDataIfNotNull($item.username)</td>
                    <td>#displayDataIfNotNull($item.passwordChanged)</td>
                    <td>#displayDataIfNotNull($item.accountNonLocked)</td>
                    <td>#displayDataIfNotNull($item.password)</td>
                </tr>
                #end
        </tbody>
    </table>
    <h1>Service providers</h1>
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Phone</th>
                <th>Is active</th>
                <th>Service type</th>
            </tr>
        </thead>
        <tbody>
                #foreach( $item in $serviceProviders )
                #if( ($foreach.index % 2) == 0 )
                <tr style="background-color: #f4f5f6">
                    #else
                <tr style="background-color: #e9ebec">
                    #end
                    <td>#displayDataIfNotNull($item.name)</td>
                    <td>#displayDataIfNotNull($item.phone)</td>
                    <td>#displayDataIfNotNull($item.isActive)</td>
                    <td>#displayDataIfNotNull($item.serviceType,$item.serviceType.label)</td>
                </tr>
                #end
        </tbody>
    </table>
    <h1>Enterprise memberships</h1>
    <table>
        <thead>
            <tr>
                <th>Collaborator</th>
                <th>Collaborator role</th>
            </tr>
        </thead>
        <tbody>
                #foreach( $item in $enterpriseMemberships )
                #if( ($foreach.index % 2) == 0 )
                <tr style="background-color: #f4f5f6">
                    #else
                <tr style="background-color: #e9ebec">
                    #end
                    <td>#displayDataIfNotNull($item.collaborator,$item.collaborator.name)</td>
                    <td>#displayDataIfNotNull($item.collaboratorRole,$item.collaboratorRole.label)</td>
                </tr>
                #end
        </tbody>
    </table>
    <h1>Ai quotas</h1>
    <table>
        <thead>
            <tr>
                <th>Tokens allocated</th>
            </tr>
        </thead>
        <tbody>
                #foreach( $item in $aiQuotas )
                #if( ($foreach.index % 2) == 0 )
                <tr style="background-color: #f4f5f6">
                    #else
                <tr style="background-color: #e9ebec">
                    #end
                    <td>#displayDataIfNotNull($item.tokensAllocated)</td>
                </tr>
                #end
        </tbody>
    </table>
    <h1>Ai usage logs</h1>
    <table>
        <thead>
            <tr>
                <th>Tokens used</th>
                <th>Date</th>
                <th>Ai usage type</th>
                <th>Collaborator</th>
                <th>Document</th>
            </tr>
        </thead>
        <tbody>
                #foreach( $item in $aiUsageLogs )
                #if( ($foreach.index % 2) == 0 )
                <tr style="background-color: #f4f5f6">
                    #else
                <tr style="background-color: #e9ebec">
                    #end
                    <td>#displayDataIfNotNull($item.tokensUsed)</td>
                    <td>#displayDataIfNotNull($item.date)</td>
                    <td>#displayDataIfNotNull($item.aiUsageType,$item.aiUsageType.label)</td>
                    <td>#displayDataIfNotNull($item.collaborator,$item.collaborator.name)</td>
                    <td>#displayDataIfNotNull($item.document,$item.document.fileName)</td>
                </tr>
                #end
        </tbody>
    </table>
    <h1>Financial reports</h1>
    <table>
        <thead>
            <tr>
                <th>Total revenue</th>
                <th>Total charges</th>
                <th>Net profit</th>
                <th>Generated at</th>
                <th>File</th>
                <th>Financial report type</th>
                <th>Financial report scope</th>
                <th>Generated by</th>
            </tr>
        </thead>
        <tbody>
                #foreach( $item in $financialReports )
                #if( ($foreach.index % 2) == 0 )
                <tr style="background-color: #f4f5f6">
                    #else
                <tr style="background-color: #e9ebec">
                    #end
                    <td>#displayDataIfNotNull($item.totalRevenue)</td>
                    <td>#displayDataIfNotNull($item.totalCharges)</td>
                    <td>#displayDataIfNotNull($item.netProfit)</td>
                    <td>#displayDataIfNotNull($item.generatedAt)</td>
                    <td>#displayDataIfNotNull($item.file)</td>
                    <td>#displayDataIfNotNull($item.financialReportType,$item.financialReportType.label)</td>
                    <td>#displayDataIfNotNull($item.financialReportScope,$item.financialReportScope.label)</td>
                    <td>#displayDataIfNotNull($item.generatedBy,$item.generatedBy.name)</td>
                </tr>
                #end
        </tbody>
    </table>
    <br/><br/>

    <div class="footer">
        <p style="font-size: 25px">MERCI POUR VOTRE SERVICE!</p>
        <p style="font-size: 18px">Si vous avez des questions, veillez contacter nous.</p>
    </div>
    <br/><br/>
    <hr style="color:#c9302c ;height: 3px"></hr>
</div>
</body>
</html>

