<!DOCTYPE html>
<html>
<head>
    <title>Invoice</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 18px;
            line-height: 1.5;
            margin: 0;
            padding: 0;

        }

        .container {
            max-width: 600px;
            margin: 0 auto;
            border: 1px solid #ccc;
            background-color: #fff;
            box-shadow: 0 0 10px #ddd;
        }

        .header {
            text-align: left;
            margin-bottom: 20px;
        }

        .header h1 {
            font-size: 35px;
            font-weight: bold;
            margin: 0;
            color: #c9302c;
        }

        .company-info {
            margin-bottom: 20px;
        }

        .company-info p {
            margin: 0;
            line-height: 1.5;
        }

        .invoice-details {
            margin-bottom: 20px;
        }

        .invoice-details p {
            margin: 0;
            line-height: 1.5;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            height: 40px;
            text-align: left;
            font-size: 17px;
            padding: 8px;
            border-bottom: 1px solid #ddd;
        }

        th {
            font-weight: bold;
        }

        .totals {
            margin-top: 20px;
            text-align: left;
        }

        .totals p {
            margin: 0;
            line-height: 1.5;
        }

        .footer {
            text-align: center;
        }

        .footer p {
            margin: 0;
            line-height: 1.5;
        }

    </style>
</head>
<body>
<div class="container">
    <div class="header" style="font-family: Noto Sans JP, sans-serif;">
        <h1>REÇU</h1>
    </div>
    <br/>
    <hr style="color:#c9302c ;height: 3px"></hr>
    <br/>

    #macro(displayComposedDataIfNotNull $object $dataToDisplay)
    #if($object)$dataToDisplay#else---#end
    #end
    #macro(displayDataIfNotNull $object)
    #if($object)$object#else---#end
    #end
    <table style="width: 100%">

                        <tr>
                    <td style="text-align: left;border-bottom: 0"><span style="font-weight: bold;">Name:</span> #displayDataIfNotNull($name)</td>
                </tr>
                <tr>
                    <td style="text-align: left;border-bottom: 0"><span style="font-weight: bold;">Phone:</span> #displayDataIfNotNull($phone)</td>
                </tr>
                <tr>
                    <td style="text-align: left;border-bottom: 0"><span style="font-weight: bold;">Is active:</span> #displayDataIfNotNull($isActive)</td>
                </tr>
                <tr>
                    <td style="text-align: left;border-bottom: 0"><span style="font-weight: bold;">Display currency:</span> #displayComposedDataIfNotNull($displayCurrency,$displayCurrency.label)</td>
                </tr>
                <tr>
                    <td style="text-align: left;border-bottom: 0"><span style="font-weight: bold;">Email:</span> #displayDataIfNotNull($email)</td>
                </tr>
                <tr>
                    <td style="text-align: left;border-bottom: 0"><span style="font-weight: bold;">Enabled:</span> #displayDataIfNotNull($enabled)</td>
                </tr>
                <tr>
                    <td style="text-align: left;border-bottom: 0"><span style="font-weight: bold;">Credentials non expired:</span> #displayDataIfNotNull($credentialsNonExpired)</td>
                </tr>
                <tr>
                    <td style="text-align: left;border-bottom: 0"><span style="font-weight: bold;">Account non expired:</span> #displayDataIfNotNull($accountNonExpired)</td>
                </tr>
                <tr>
                    <td style="text-align: left;border-bottom: 0"><span style="font-weight: bold;">Username:</span> #displayDataIfNotNull($username)</td>
                </tr>
                <tr>
                    <td style="text-align: left;border-bottom: 0"><span style="font-weight: bold;">Password changed:</span> #displayDataIfNotNull($passwordChanged)</td>
                </tr>
                <tr>
                    <td style="text-align: left;border-bottom: 0"><span style="font-weight: bold;">Account non locked:</span> #displayDataIfNotNull($accountNonLocked)</td>
                </tr>
                <tr>
                    <td style="text-align: left;border-bottom: 0"><span style="font-weight: bold;">Password:</span> #displayDataIfNotNull($password)</td>
                </tr>

    </table>
    <br/><br/><br/><br/><br/>
    <h1>Enterprise memberships</h1>
    <table>
        <thead>
            <tr>
                <th>Enterprise</th>
                <th>Collaborator role</th>
            </tr>
        </thead>
        <tbody>
                #foreach( $item in $enterpriseMemberships )
                #if( ($foreach.index % 2) == 0 )
                <tr style="background-color: #f4f5f6">
                    #else
                <tr style="background-color: #e9ebec">
                    #end
                    <td>#displayDataIfNotNull($item.enterprise,$item.enterprise.name)</td>
                    <td>#displayDataIfNotNull($item.collaboratorRole,$item.collaboratorRole.label)</td>
                </tr>
                #end
        </tbody>
    </table>
    <h1>Ai usage logs</h1>
    <table>
        <thead>
            <tr>
                <th>Tokens used</th>
                <th>Date</th>
                <th>Enterprise</th>
                <th>Ai usage type</th>
                <th>Document</th>
            </tr>
        </thead>
        <tbody>
                #foreach( $item in $aiUsageLogs )
                #if( ($foreach.index % 2) == 0 )
                <tr style="background-color: #f4f5f6">
                    #else
                <tr style="background-color: #e9ebec">
                    #end
                    <td>#displayDataIfNotNull($item.tokensUsed)</td>
                    <td>#displayDataIfNotNull($item.date)</td>
                    <td>#displayDataIfNotNull($item.enterprise,$item.enterprise.name)</td>
                    <td>#displayDataIfNotNull($item.aiUsageType,$item.aiUsageType.label)</td>
                    <td>#displayDataIfNotNull($item.document,$item.document.fileName)</td>
                </tr>
                #end
        </tbody>
    </table>
    <h1>Tasks</h1>
    <table>
        <thead>
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Property</th>
                <th>Reservation</th>
                <th>Service provider</th>
                <th>Task type</th>
                <th>Task priority</th>
                <th>Task status</th>
            </tr>
        </thead>
        <tbody>
                #foreach( $item in $tasks )
                #if( ($foreach.index % 2) == 0 )
                <tr style="background-color: #f4f5f6">
                    #else
                <tr style="background-color: #e9ebec">
                    #end
                    <td>#displayDataIfNotNull($item.title)</td>
                    <td>#displayDataIfNotNull($item.description)</td>
                    <td>#displayDataIfNotNull($item.property,$item.property.name)</td>
                    <td>#displayDataIfNotNull($item.reservation,$item.reservation.reference)</td>
                    <td>#displayDataIfNotNull($item.serviceProvider,$item.serviceProvider.name)</td>
                    <td>#displayDataIfNotNull($item.taskType,$item.taskType.label)</td>
                    <td>#displayDataIfNotNull($item.taskPriority,$item.taskPriority.label)</td>
                    <td>#displayDataIfNotNull($item.taskStatus,$item.taskStatus.label)</td>
                </tr>
                #end
        </tbody>
    </table>
    <h1>Reservation requests</h1>
    <table>
        <thead>
            <tr>
                <th>Client note</th>
                <th>Staff note</th>
                <th>Client</th>
                <th>Requested property</th>
                <th>Alternative property</th>
                <th>Reservation request status</th>
                <th>Reservation</th>
            </tr>
        </thead>
        <tbody>
                #foreach( $item in $reservationRequests )
                #if( ($foreach.index % 2) == 0 )
                <tr style="background-color: #f4f5f6">
                    #else
                <tr style="background-color: #e9ebec">
                    #end
                    <td>#displayDataIfNotNull($item.clientNote)</td>
                    <td>#displayDataIfNotNull($item.staffNote)</td>
                    <td>#displayDataIfNotNull($item.client,$item.client.fullName)</td>
                    <td>#displayDataIfNotNull($item.requestedProperty,$item.requestedProperty.name)</td>
                    <td>#displayDataIfNotNull($item.alternativeProperty,$item.alternativeProperty.name)</td>
                    <td>#displayDataIfNotNull($item.reservationRequestStatus,$item.reservationRequestStatus.label)</td>
                    <td>#displayDataIfNotNull($item.reservation,$item.reservation.reference)</td>
                </tr>
                #end
        </tbody>
    </table>
    <br/><br/>

    <div class="footer">
        <p style="font-size: 25px">MERCI POUR VOTRE SERVICE!</p>
        <p style="font-size: 18px">Si vous avez des questions, veillez contacter nous.</p>
    </div>
    <br/><br/>
    <hr style="color:#c9302c ;height: 3px"></hr>
</div>
</body>
</html>

