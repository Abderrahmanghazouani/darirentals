<!-- db/changelog-1.1-container.xml -->

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

  <!-- Create Container Table -->
    <changeSet id="1" author="your-name">
    <createTable tableName="payment">
      <column name="id" type="BIGINT">
        <constraints primaryKey="true" nullable="false"/>
      </column>
        <column name="amount" type="NUMERIC"/>
        <column name="notes" type="VARCHAR(500)"/>

        <column name="service_provider_id" type="BIGINT">
          <constraints nullable="false"/>
        </column>
        <column name="payment_type_id" type="BIGINT">
          <constraints nullable="false"/>
        </column>
        <column name="payment_status_id" type="BIGINT">
          <constraints nullable="false"/>
        </column>

    </createTable>
  </changeSet>

    <!-- Add foreign key constraint -->
  <changeSet id="2" author="your-name">
      <addForeignKeyConstraint
              baseTableName="payment"
              baseColumnNames="service_provider_id"
              referencedTableName="service_provider"
              referencedColumnNames="id"
              constraintName="fk_payment_service_provider"/>
      <addForeignKeyConstraint
              baseTableName="payment"
              baseColumnNames="payment_type_id"
              referencedTableName="payment_type"
              referencedColumnNames="id"
              constraintName="fk_payment_payment_type"/>
      <addForeignKeyConstraint
              baseTableName="payment"
              baseColumnNames="payment_status_id"
              referencedTableName="payment_status"
              referencedColumnNames="id"
              constraintName="fk_payment_payment_status"/>

  </changeSet>

    <!-- Create Sequence for ContainerType -->
  <changeSet id="3" author="your-name">
    <createSequence sequenceName="payment_seq" startValue="1" incrementBy="1"/>
  </changeSet>

  <!-- Load Data from CSV -->
  <changeSet id="4" author="your-name">
    <loadData
            file="classpath:/db/migration/data/payment/Payment.csv"
            tableName="payment">
      <column name="id" type="NUMERIC"/>
          <column name="amount" type="NUMERIC"/>
          <column name="notes" type="STRING"/>
        <column name="service_provider" type="BIGINT"/>
        <column name="payment_type" type="BIGINT"/>
        <column name="payment_status" type="BIGINT"/>
    </loadData>
  </changeSet>


</databaseChangeLog>
