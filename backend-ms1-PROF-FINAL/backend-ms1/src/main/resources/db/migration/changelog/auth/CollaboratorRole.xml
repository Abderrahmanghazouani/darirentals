<!-- db/changelog-1.1-container.xml -->

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

  <!-- Create Container Table -->
    <changeSet id="1" author="your-name">
    <createTable tableName="collaborator_role">
      <column name="id" type="BIGINT">
        <constraints primaryKey="true" nullable="false"/>
      </column>
        <column name="description" type="VARCHAR(500)"/>
        <column name="code" type="VARCHAR(500)"/>
        <column name="label" type="VARCHAR(500)"/>
        <column name="style" type="VARCHAR(500)"/>
        <column name="is_default" type="TINYINT"/>
        <column name="sort_order" type="BIGINT"/>
        <column name="can_manage_financials" type="TINYINT"/>
        <column name="can_manage_users" type="TINYINT"/>
        <column name="can_delete_property" type="TINYINT"/>
        <column name="can_manage_service_providers" type="TINYINT"/>
        <column name="can_manage_ai_usage" type="TINYINT"/>


    </createTable>
  </changeSet>


    <!-- Create Sequence for ContainerType -->
  <changeSet id="2" author="your-name">
    <createSequence sequenceName="collaborator_role_seq" startValue="1" incrementBy="1"/>
  </changeSet>

  <!-- Load Data from CSV -->
  <changeSet id="3" author="your-name">
    <loadData
            file="classpath:/db/migration/data/auth/CollaboratorRole.csv"
            tableName="collaborator_role">
      <column name="id" type="NUMERIC"/>
          <column name="description" type="STRING"/>
          <column name="code" type="STRING"/>
          <column name="label" type="STRING"/>
          <column name="style" type="STRING"/>
          <column name="is_default" type="BOOLEAN"/>
          <column name="sort_order" type="NUMERIC"/>
          <column name="can_manage_financials" type="BOOLEAN"/>
          <column name="can_manage_users" type="BOOLEAN"/>
          <column name="can_delete_property" type="BOOLEAN"/>
          <column name="can_manage_service_providers" type="BOOLEAN"/>
          <column name="can_manage_ai_usage" type="BOOLEAN"/>
    </loadData>
  </changeSet>


</databaseChangeLog>
