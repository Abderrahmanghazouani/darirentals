<!-- db/changelog-1.1-container.xml -->

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

  <!-- Create Container Table -->
    <changeSet id="1" author="your-name">
    <createTable tableName="reservation_request">
      <column name="id" type="BIGINT">
        <constraints primaryKey="true" nullable="false"/>
      </column>
        <column name="client_note" type="VARCHAR(500)"/>
        <column name="staff_note" type="VARCHAR(500)"/>

        <column name="client_id" type="BIGINT">
          <constraints nullable="false"/>
        </column>
        <column name="requested_property_id" type="BIGINT">
          <constraints nullable="false"/>
        </column>
        <column name="alternative_property_id" type="BIGINT">
          <constraints nullable="false"/>
        </column>
        <column name="reviewed_by_id" type="BIGINT">
          <constraints nullable="false"/>
        </column>
        <column name="reservation_request_status_id" type="BIGINT">
          <constraints nullable="false"/>
        </column>
        <column name="reservation_id" type="BIGINT">
          <constraints nullable="false"/>
        </column>

    </createTable>
  </changeSet>

    <!-- Add foreign key constraint -->
  <changeSet id="2" author="your-name">
      <addForeignKeyConstraint
              baseTableName="reservation_request"
              baseColumnNames="client_id"
              referencedTableName="client"
              referencedColumnNames="id"
              constraintName="fk_reservation_request_client"/>
      <addForeignKeyConstraint
              baseTableName="reservation_request"
              baseColumnNames="requested_property_id"
              referencedTableName="requested_property"
              referencedColumnNames="id"
              constraintName="fk_reservation_request_requested_property"/>
      <addForeignKeyConstraint
              baseTableName="reservation_request"
              baseColumnNames="alternative_property_id"
              referencedTableName="alternative_property"
              referencedColumnNames="id"
              constraintName="fk_reservation_request_alternative_property"/>
      <addForeignKeyConstraint
              baseTableName="reservation_request"
              baseColumnNames="reviewed_by_id"
              referencedTableName="reviewed_by"
              referencedColumnNames="id"
              constraintName="fk_reservation_request_reviewed_by"/>
      <addForeignKeyConstraint
              baseTableName="reservation_request"
              baseColumnNames="reservation_request_status_id"
              referencedTableName="reservation_request_status"
              referencedColumnNames="id"
              constraintName="fk_reservation_request_reservation_request_status"/>
      <addForeignKeyConstraint
              baseTableName="reservation_request"
              baseColumnNames="reservation_id"
              referencedTableName="reservation"
              referencedColumnNames="id"
              constraintName="fk_reservation_request_reservation"/>

  </changeSet>

    <!-- Create Sequence for ContainerType -->
  <changeSet id="3" author="your-name">
    <createSequence sequenceName="reservation_request_seq" startValue="1" incrementBy="1"/>
  </changeSet>

  <!-- Load Data from CSV -->
  <changeSet id="4" author="your-name">
    <loadData
            file="classpath:/db/migration/data/reservation/ReservationRequest.csv"
            tableName="reservation_request">
      <column name="id" type="NUMERIC"/>
          <column name="client_note" type="STRING"/>
          <column name="staff_note" type="STRING"/>
        <column name="client" type="BIGINT"/>
        <column name="requested_property" type="BIGINT"/>
        <column name="alternative_property" type="BIGINT"/>
        <column name="reviewed_by" type="BIGINT"/>
        <column name="reservation_request_status" type="BIGINT"/>
        <column name="reservation" type="BIGINT"/>
    </loadData>
  </changeSet>


</databaseChangeLog>
