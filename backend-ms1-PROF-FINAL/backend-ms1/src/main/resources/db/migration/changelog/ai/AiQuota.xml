<!-- db/changelog-1.1-container.xml -->

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

  <!-- Create Container Table -->
    <changeSet id="1" author="your-name">
    <createTable tableName="ai_quota">
      <column name="id" type="BIGINT">
        <constraints primaryKey="true" nullable="false"/>
      </column>
        <column name="tokens_allocated" type="BIGINT"/>

        <column name="enterprise_id" type="BIGINT">
          <constraints nullable="false"/>
        </column>

    </createTable>
  </changeSet>

    <!-- Add foreign key constraint -->
  <changeSet id="2" author="your-name">
      <addForeignKeyConstraint
              baseTableName="ai_quota"
              baseColumnNames="enterprise_id"
              referencedTableName="enterprise"
              referencedColumnNames="id"
              constraintName="fk_ai_quota_enterprise"/>

  </changeSet>

    <!-- Create Sequence for ContainerType -->
  <changeSet id="3" author="your-name">
    <createSequence sequenceName="ai_quota_seq" startValue="1" incrementBy="1"/>
  </changeSet>

  <!-- Load Data from CSV -->
  <changeSet id="4" author="your-name">
    <loadData
            file="classpath:/db/migration/data/ai/AiQuota.csv"
            tableName="ai_quota">
      <column name="id" type="NUMERIC"/>
          <column name="tokens_allocated" type="NUMERIC"/>
        <column name="enterprise" type="BIGINT"/>
    </loadData>
  </changeSet>


</databaseChangeLog>
