<!-- db/changelog-1.1-container.xml -->

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

  <!-- Create Container Table -->
    <changeSet id="1" author="your-name">
    <createTable tableName="enterprise_membership">
      <column name="id" type="BIGINT">
        <constraints primaryKey="true" nullable="false"/>
      </column>

        <column name="collaborator_id" type="BIGINT">
          <constraints nullable="false"/>
        </column>
        <column name="enterprise_id" type="BIGINT">
          <constraints nullable="false"/>
        </column>
        <column name="collaborator_role_id" type="BIGINT">
          <constraints nullable="false"/>
        </column>

    </createTable>
  </changeSet>

    <!-- Add foreign key constraint -->
  <changeSet id="2" author="your-name">
      <addForeignKeyConstraint
              baseTableName="enterprise_membership"
              baseColumnNames="collaborator_id"
              referencedTableName="collaborator"
              referencedColumnNames="id"
              constraintName="fk_enterprise_membership_collaborator"/>
      <addForeignKeyConstraint
              baseTableName="enterprise_membership"
              baseColumnNames="enterprise_id"
              referencedTableName="enterprise"
              referencedColumnNames="id"
              constraintName="fk_enterprise_membership_enterprise"/>
      <addForeignKeyConstraint
              baseTableName="enterprise_membership"
              baseColumnNames="collaborator_role_id"
              referencedTableName="collaborator_role"
              referencedColumnNames="id"
              constraintName="fk_enterprise_membership_collaborator_role"/>

  </changeSet>

    <!-- Create Sequence for ContainerType -->
  <changeSet id="3" author="your-name">
    <createSequence sequenceName="enterprise_membership_seq" startValue="1" incrementBy="1"/>
  </changeSet>

  <!-- Load Data from CSV -->
  <changeSet id="4" author="your-name">
    <loadData
            file="classpath:/db/migration/data/enterprise/EnterpriseMembership.csv"
            tableName="enterprise_membership">
      <column name="id" type="NUMERIC"/>
        <column name="collaborator" type="BIGINT"/>
        <column name="enterprise" type="BIGINT"/>
        <column name="collaborator_role" type="BIGINT"/>
    </loadData>
  </changeSet>


</databaseChangeLog>
