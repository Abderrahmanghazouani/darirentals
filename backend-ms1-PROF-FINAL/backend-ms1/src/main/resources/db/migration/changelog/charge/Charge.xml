<!-- db/changelog-1.1-container.xml -->

<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

  <!-- Create Container Table -->
    <changeSet id="1" author="your-name">
    <createTable tableName="charge">
      <column name="id" type="BIGINT">
        <constraints primaryKey="true" nullable="false"/>
      </column>
        <column name="label" type="VARCHAR(500)"/>
        <column name="amount" type="NUMERIC"/>

        <column name="property_id" type="BIGINT">
          <constraints nullable="false"/>
        </column>
        <column name="charge_type_id" type="BIGINT">
          <constraints nullable="false"/>
        </column>
        <column name="payment_id" type="BIGINT">
          <constraints nullable="false"/>
        </column>

    </createTable>
  </changeSet>

    <!-- Add foreign key constraint -->
  <changeSet id="2" author="your-name">
      <addForeignKeyConstraint
              baseTableName="charge"
              baseColumnNames="property_id"
              referencedTableName="property"
              referencedColumnNames="id"
              constraintName="fk_charge_property"/>
      <addForeignKeyConstraint
              baseTableName="charge"
              baseColumnNames="charge_type_id"
              referencedTableName="charge_type"
              referencedColumnNames="id"
              constraintName="fk_charge_charge_type"/>
      <addForeignKeyConstraint
              baseTableName="charge"
              baseColumnNames="payment_id"
              referencedTableName="payment"
              referencedColumnNames="id"
              constraintName="fk_charge_payment"/>

  </changeSet>

    <!-- Create Sequence for ContainerType -->
  <changeSet id="3" author="your-name">
    <createSequence sequenceName="charge_seq" startValue="1" incrementBy="1"/>
  </changeSet>

  <!-- Load Data from CSV -->
  <changeSet id="4" author="your-name">
    <loadData
            file="classpath:/db/migration/data/charge/Charge.csv"
            tableName="charge">
      <column name="id" type="NUMERIC"/>
          <column name="label" type="STRING"/>
          <column name="amount" type="NUMERIC"/>
        <column name="property" type="BIGINT"/>
        <column name="charge_type" type="BIGINT"/>
        <column name="payment" type="BIGINT"/>
    </loadData>
  </changeSet>


</databaseChangeLog>
